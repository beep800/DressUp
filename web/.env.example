# The n8n webhook that serves the dashboard data (see ../n8n/README.md).
# Leave empty to run on generated demo data.
VITE_DATA_URL=
# VITE_DATA_URL=/n8n/webhook/maternal-health-atlas

# Where n8n runs. The dev server forwards /n8n/... here.
# n8n Cloud: https://<your-name>.app.n8n.cloud
N8N_URL=http://localhost:5678

# The secret set in the workflow's "Dashboard key" credential. Sent by the dev
# server only; it never reaches the browser. Keep this file out of git.
N8N_KEY=
