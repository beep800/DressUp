# Pick one data source. With none set, the dashboard runs on generated demo data.

# Option A: an n8n workflow serves the data (see n8n/README.md).
# The dev server forwards /n8n/... to N8N_URL.
VITE_DATA_URL=
# VITE_DATA_URL=/n8n/webhook/maternal-health-atlas
N8N_URL=http://localhost:5678

# Option B: read Supabase directly (Project Settings → API). Users must sign in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
